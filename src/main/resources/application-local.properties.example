# ============================================================
# FILE MẪU - Copy file này thành application-local.properties
# application-local.properties đã bị .gitignore, KHÔNG commit file đó.
# Giá trị thật hỏi Dũ nha, không đưa lên git.
# ============================================================

# -- DATABASE (Railway MySQL - kết nối qua public proxy)
# Lấy từ Railway > service MySQL > Variables > MYSQL_PUBLIC_URL
#   mysql://<user>:<password>@<host>:<port>/<database>

DB_URL=jdbc:mysql://<host>.proxy.rlwy.net:<port>/railway?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=

# -- JWT
# Tạo bằng lệnh: openssl rand -base64 32
JWT_SECRET=

# -- VNPAY (sandbox)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# -- GOOGLE
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=

# -- TÀI KHOẢN MẶC ĐỊNH (tạo lúc khởi động nếu email chưa tồn tại)
# Để trống = không tạo. Manager: admin@sportcenter.com
# Coach / Lễ tân: coach@Sportcenter.com, receptionist@Sportcenter.com (dùng chung mật khẩu)
APP_INIT_MANAGER_PASSWORD=
APP_INIT_COACH_PASSWORD=
APP_INIT_RECEPTIONIST_PASSWORD=

# -- AI (không bắt buộc): có key thì gợi ý bài tập / trợ lý dùng Claude, để trống thì dùng gợi ý tự động
# ANTHROPIC_API_KEY=

# -- Không bắt buộc khi chạy local (đã có giá trị mặc định trong application.properties)
# CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# VNPAY_RETURN_URL=http://localhost:5173/payment-result
